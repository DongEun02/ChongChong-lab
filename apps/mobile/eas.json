{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "doply": {
      "extends": "production",
      "env": {
        "ANDROID_TARGET_SDK_VERSION": "35"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
