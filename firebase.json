{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --dir functions lint",
      "pnpm --dir functions typecheck",
      "pnpm --dir functions test",
      "pnpm --dir functions build"
    ]
  },
  "firestore": {
    "indexes": "firestore.indexes.json",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
