rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /assignment-submissions/{studyId}/{assignmentId}/{userId}/{fileName} {
      allow read: if isActiveStudyMember(studyId);
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isActiveStudyMember(studyId)
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('.*\\.pdf');
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    function isActiveStudyMember(studyId) {
      return request.auth != null
        && firestore.get(
          /databases/(default)/documents/studies/$(studyId)/members/$(request.auth.uid)
        ).data.status == 'active';
    }
  }
}
